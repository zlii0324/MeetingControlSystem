# 数据库
PORT=5001
DATABASE_PATH=./instance/meetings.sqlite3

# 服务器地址（填写完整的 http:// 或 https:// 地址）
JITSI_BASE_URL=
FRONTEND_ORIGIN=
MEETING_LINK_ORIGIN=
ROOM_PREFIX=mcs

# 安全配置（生产环境必须填写高强度随机字符串）
PASSWORD_SECRET=
SESSION_COOKIE_NAME=mcs_session
SESSION_TTL_DAYS=7
# HTTPS 填 true，仅 HTTP 填 false
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=Lax

# 会议默认配置
DEFAULT_DURATION_HOURS=24
DEFAULT_MAX_OCCUPANTS=30
RESERVATION_EARLY_JOIN_MINUTES=15
ENABLE_CORS=true

# 邮件通知（补齐 SMTP 配置并测试成功后改为 true）
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 通常为 TLS=true、SSL=false；465 通常相反
SMTP_USE_TLS=
SMTP_USE_SSL=
# 生产环境应为 true；仅自签名服务器测试时使用 false
SMTP_VERIFY_CERTIFICATE=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=
EMAIL_FROM_NAME=会议管理系统
EMAIL_TIMEZONE=Asia/Shanghai
